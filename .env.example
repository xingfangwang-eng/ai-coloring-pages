# ============================================
# AI Coloring Pages 环境变量模板
# 复制为 .env.local 后填入真实值
# ============================================

# -------- Google AI Studio (主引擎，必须) --------
# 免费 Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# -------- Pollinations 降级引擎（免费，无需 Key） --------
POLLINATIONS_BASE_URL=

# -------- NextAuth v5 (Auth.js) --------
# 应用基础 URL（开发时 http://localhost:3000，生产时你的域名）
AUTH_URL=http://localhost:3000
# 随机长字符串：openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# ====== OAuth Provider（按需要配置，一个都不配也能跑） ======

# GitHub —— https://github.com/settings/developers
# callback: <AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google —— https://console.cloud.google.com/apis/credentials
# callback: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Discord —— https://discord.com/developers/applications
# callback: <AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Email 魔法链接（可选，需要 SMTP 或 Resend）
# Resend: https://resend.com（免费额度足够个人用）
# AUTH_RESEND_KEY=
# 或自建 SMTP：
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=xingfang.wang@gmail.com

# -------- Supabase（免费 PostgreSQL，选填） --------
# 创建于 https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
